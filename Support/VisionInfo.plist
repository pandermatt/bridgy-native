<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Multiple scenes: an immersive space is a second scene, and there is no
	     INFOPLIST_KEY_ alias for this. Document types: agents travel as
	     .bridgyagent files. Both merge with the generated keys. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Bridgy Agent</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>ch.pandermatt.bridgy.agent</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>NSWorldSensingUsageDescription</key>
	<string>Bridgy looks for a table to set the board on.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Bridgy Agent</string>
			<key>UTTypeIdentifier</key>
			<string>ch.pandermatt.bridgy.agent</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>bridgyagent</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-bridgy-agent</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>NSSupportsGroupActivities</key>
	<true/>
</dict>
</plist>
