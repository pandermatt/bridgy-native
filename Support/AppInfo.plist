<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Agents travel as .bridgyagent files — shared, AirDropped, opened from Files
		or Finder — which needs an exported type and a document type. Neither has
		an INFOPLIST_KEY_ alias, so they live here and merge with the generated keys.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ch.pandermatt.bridgy</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bridgy</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Bridgy Agent</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>ch.pandermatt.bridgy.agent</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Bridgy Agent</string>
			<key>UTTypeIdentifier</key>
			<string>ch.pandermatt.bridgy.agent</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>bridgyagent</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-bridgy-agent</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>NSSupportsGroupActivities</key>
	<true/>
</dict>
</plist>
